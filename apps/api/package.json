{
  "name": "@org/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"swc src -d dist --strip-leading-paths --watch\" \"node --watch dist/main.js\"",
    "build": "swc src -d dist --strip-leading-paths",
    "clean": "node -e \"['dist','node_modules'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "check-db": "node scripts/check-db.js",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^11.1.28",
    "@org/dal": "workspace:*",
    "@org/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-auth": "^1.6.25",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.0.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.0.0",
    "nodemailer": "^9.0.3",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^7.0.0",
    "concurrently": "^10.0.4"
  }
}
