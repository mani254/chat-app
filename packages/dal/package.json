{
  "name": "@org/dal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "clean": "node -e \"['dist','node_modules'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json"
  },
  "dependencies": {
    "@org/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "mongoose": "^9.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "typescript": "~5.7.3"
  }
}
