{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node", "react", "react-dom"],
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuildinfo/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*"]
}
