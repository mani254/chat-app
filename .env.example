# Application
NODE_ENV=development
PORT=8080
API_PREFIX=api
API_DEFAULT_VERSION=1
CORS_ORIGIN=http://localhost:4200,http://localhost:3001,http://localhost:3000,http://localhost:5173

# MongoDB (via @org/dal)
MONGODB_URI=mongodb://localhost:27017/chat-app
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Better Auth & OAuth
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_API_KEY=your_better_auth_api_key_here
BETTER_AUTH_URL=http://localhost:8080
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMTP / Brevo Mail Integration
SIB_API_KEY=your_brevo_api_key_here
SMTP_USER=your_smtp_user_here
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# Redis (optional — leave empty until Redis is configured)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
